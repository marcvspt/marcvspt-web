---
import { TEXTS_GENERAL } from "@/scripts/texts";
import BaseLayout from "@/layouts/BaseLayout.astro";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TimeLineCard from "@/components/TimeLineCard.astro";
import CardWithIcon from "@/components/CardWithIcon.astro";

import ControlIcon from "@/assets/control.svg";
import CoffeeIcon from "@/assets/coffee.svg";

import {
  SITE_PAGES,
  SKILLS,
  PROFESIONAL_EXPERIENCE,
} from "@/scripts/data.js";
---

<BaseLayout
  title={SITE_PAGES.About.title}
  description={SITE_PAGES.About.description}
>
  <Header />

  <main class="pt-16">
    <!-- Hero Section -->
    <section
      class="bg-linear-to-br from-slate-900 via-blue-900 to-slate-900 py-20"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="mb-8 animate-fade-in">
            <div
              class="w-32 h-32 mx-auto mb-6 rounded-full bg-linear-to-br from-blue-400 to-blue-600 p-1"
            >
              <div
                class="w-full h-full rounded-full bg-slate-800 flex items-center justify-center"
              >
                <img
                  class="rounded-full"
                  src="/img/logo.webp"
                  alt={TEXTS_GENERAL.about.avatarAlt}
                />
              </div>
            </div>
          </div>

          <h1 class="text-4xl md:text-6xl font-bold mb-6 animate-slide-up">
            <span
              class="bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
            >
              {SITE_PAGES.About.title}
            </span>
          </h1>

          <p
            class="text-xl text-slate-300 max-w-2xl mx-auto animate-slide-up"
            style="animation-delay: 0.2s;"
          >
            {TEXTS_GENERAL.about.intro.before} <strong
              >{TEXTS_GENERAL.about.intro.highlight}</strong
            > {TEXTS_GENERAL.about.intro.after}
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-20 bg-slate-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Main Story -->
          <div class="lg:col-span-2 space-y-8">
            <div class="animate-slide-up" style="animation-delay: 0.3s;">
              <h2 class="text-3xl font-bold text-white mb-6">{TEXTS_GENERAL.about.story.title}</h2>
              <div class="prose prose-lg prose-invert max-w-none">
                <p class="text-slate-300 leading-relaxed mb-6">
                  {TEXTS_GENERAL.about.story.introduction}
                </p>

                <p class="text-slate-300 leading-relaxed mb-6">
                  {TEXTS_GENERAL.about.story.specialization}
                </p>

                <p class="text-slate-300 leading-relaxed mb-6">
                  {TEXTS_GENERAL.about.story.blog}
                </p>
              </div>
            </div>

            <div class="animate-slide-up" style="animation-delay: 0.4s;">
              <h2 class="text-3xl font-bold text-white mb-6">{TEXTS_GENERAL.about.philosophy.title}</h2>
              <div
                class="bg-slate-800/50 rounded-xl p-6 border border-slate-700"
              >
                <blockquote class="text-lg text-slate-300 italic">
                  {TEXTS_GENERAL.about.philosophy.quote}
                </blockquote>
              </div>
            </div>

            <div class="animate-slide-up" style="animation-delay: 0.5s;">
              <h2 class="text-3xl font-bold text-white mb-6">
                {TEXTS_GENERAL.about.hobbies.title}
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <CardWithIcon
                  title={TEXTS_GENERAL.about.hobbies.coffee.title}
                  description={TEXTS_GENERAL.about.hobbies.coffee.description}
                >
                  <CoffeeIcon slot="icon" />
                </CardWithIcon>

                <CardWithIcon
                  title={TEXTS_GENERAL.about.hobbies.games.title}
                  description={TEXTS_GENERAL.about.hobbies.games.description}
                >
                  <ControlIcon slot="icon" />
                </CardWithIcon>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="space-y-8">
            <!-- Skills -->
            <div class="animate-slide-up" style="animation-delay: 0.6s;">
              <h3 class="text-2xl font-bold text-white mb-6">
                {TEXTS_GENERAL.about.skillsTitle}
              </h3>
              <div class="space-y-4">
                {
                  SKILLS.map((skills) => {
                    return (
                      <div class="bg-slate-800/30 rounded-lg p-4 border border-slate-700 hover:bg-slate-800/50 transition-all duration-300">
                        <div class="flex justify-between items-center mb-3">
                          <span class="text-white font-medium">
                            {skills.name}
                          </span>
                          <span class="text-blue-400 text-sm font-medium">
                            {skills.percentaje}
                          </span>
                        </div>
                        <div class="w-full bg-slate-700 rounded-full h-1.5">
                          <div
                            class="bg-linear-to-r from-blue-500 to-blue-600 h-1.5 rounded-full transition-all duration-1000 ease-out"
                            style={`width: ${skills.percentaje}`}
                          />
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-800/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            <span
              class="bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
            >
              {TEXTS_GENERAL.about.experience.title}
            </span>
          </h2>
          <p class="text-xl text-slate-400">
            {TEXTS_GENERAL.about.experience.description}
          </p>
        </div>

        <div class="relative">
          <!-- Timeline line -->
          <div
            class="absolute left-1/2 transform -translate-x-1/2 w-0.5 h-full bg-linear-to-b from-blue-500 to-blue-600"
          >
          </div>

          <!-- Timeline items -->
          <div class="space-y-12">
            <TimeLineCard
              ocupation={PROFESIONAL_EXPERIENCE.gobierno.ocupation}
              description={PROFESIONAL_EXPERIENCE.gobierno.description}
              company={PROFESIONAL_EXPERIENCE.gobierno.company}
              time={PROFESIONAL_EXPERIENCE.gobierno.time}
              link={PROFESIONAL_EXPERIENCE.gobierno.link}
              side="left"
              delay="0.9s"
            />
            <TimeLineCard
              ocupation={PROFESIONAL_EXPERIENCE.rooms31.ocupation}
              description={PROFESIONAL_EXPERIENCE.rooms31.description}
              company={PROFESIONAL_EXPERIENCE.rooms31.company}
              time={PROFESIONAL_EXPERIENCE.rooms31.time}
              link={PROFESIONAL_EXPERIENCE.rooms31.link}
              side="right"
              delay="1s"
            />
            <TimeLineCard
              ocupation={PROFESIONAL_EXPERIENCE.conexionesTI.ocupation}
              description={PROFESIONAL_EXPERIENCE.conexionesTI.description}
              company={PROFESIONAL_EXPERIENCE.conexionesTI.company}
              time={PROFESIONAL_EXPERIENCE.conexionesTI.time}
              link={PROFESIONAL_EXPERIENCE.conexionesTI.link}
              side="left"
              delay="1.1s"
            />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
