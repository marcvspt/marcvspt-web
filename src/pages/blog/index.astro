---
import { TEXTS_GENERAL } from "@/scripts/texts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostCard from "@/components/PostCard.astro";
import { SITE_PAGES } from "@/scripts/data.js";
import { getPublishedPostCards, getReadTimeMinutes } from "@/scripts/blog";

const processedPosts = await getPublishedPostCards();
const categories = [...new Set(processedPosts.map((post) => post.category))];
const totalPosts = processedPosts.length;
const avgReadTime = totalPosts === 0 ? 0 : Math.round(
  processedPosts.reduce((sum, post) => sum + getReadTimeMinutes(post.readTime), 0) / totalPosts,
);
---

<BaseLayout
  title={SITE_PAGES.Blog.title}
  description={SITE_PAGES.Blog.description}
>
  <Header />

  <main class="pt-16">
    <!-- Hero Section -->
    <section
      class="bg-linear-to-r from-slate-900 via-blue-900 to-slate-900 py-20"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-6xl font-bold mb-6">
            <span
              class="bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
            >
              {TEXTS_GENERAL.blog.title}
            </span>
          </h1>
          <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-8">
            {TEXTS_GENERAL.blog.description}
          </p>

          <!-- Stats -->
          <div class="flex flex-wrap justify-center gap-8 mb-8">
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-400">{totalPosts}</div>
              <div class="text-slate-400 text-sm">{TEXTS_GENERAL.blog.stats.articles}</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-400">
                {categories.length}
              </div>
              <div class="text-slate-400 text-sm">{TEXTS_GENERAL.blog.stats.categories}</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-400">
                {avgReadTime}
              </div>
              <div class="text-slate-400 text-sm">{TEXTS_GENERAL.blog.stats.averageMinutes}</div>
            </div>
          </div>

          <!-- Search Bar -->
          <div class="max-w-md mx-auto">
            <div class="relative">
              <input
                type="text"
                id="searchInput" aria-label={TEXTS_GENERAL.blog.search.label}
                placeholder={TEXTS_GENERAL.blog.search.placeholder}
                class="w-full px-4 py-3 pl-12 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all duration-300"
              />
              <svg
                class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filter Categories -->
    <section
      class="bg-slate-800/30 py-8 sticky top-16 z-40 backdrop-blur-sm border-b border-slate-700"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap justify-center gap-3">
          <button
            class="category-filter active px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-medium transition-all duration-300 hover:bg-blue-500"
            data-category="all"
          >
            {TEXTS_GENERAL.blog.all} ({totalPosts})
          </button>
          {
            categories.map((category) => {
              const count = processedPosts.filter(
                (post) => post.category === category,
              ).length;
              return (
                <button
                  class="category-filter px-4 py-2 bg-slate-700 text-slate-300 rounded-full text-sm font-medium transition-all duration-300 hover:bg-slate-600 hover:text-white"
                  data-category={category}
                >
                  {category} ({count})
                </button>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Sort Options -->
    <section class="bg-slate-900 py-6">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap justify-between items-center gap-4">
          <div class="flex items-center gap-4">
            <span class="text-slate-400 text-sm">{TEXTS_GENERAL.blog.sort.label}</span>
            <select
              id="sortSelect" aria-label={TEXTS_GENERAL.blog.sort.accessibleLabel}
              class="bg-slate-800 border border-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:border-blue-500"
            >
              <option value="date-desc">{TEXTS_GENERAL.blog.sort.newest}</option>
              <option value="date-asc">{TEXTS_GENERAL.blog.sort.oldest}</option>
              <option value="title-asc">{TEXTS_GENERAL.blog.sort.titleAscending}</option>
              <option value="title-desc">{TEXTS_GENERAL.blog.sort.titleDescending}</option>
              <option value="readtime-asc">{TEXTS_GENERAL.blog.sort.shortest}</option>
              <option value="readtime-desc">{TEXTS_GENERAL.blog.sort.longest}</option>
            </select>
          </div>

          <div class="flex items-center gap-4">
            <span class="text-slate-400 text-sm">{TEXTS_GENERAL.blog.view.label}</span>
            <div class="flex bg-slate-800 rounded-lg p-1">
              <button
                id="gridView" aria-label={TEXTS_GENERAL.blog.view.grid} aria-pressed="true"
                class="view-toggle active px-3 py-1 rounded text-sm transition-all duration-300"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
                  ></path>
                </svg>
              </button>
              <button
                id="listView" aria-label={TEXTS_GENERAL.blog.view.list} aria-pressed="false"
                class="view-toggle px-3 py-1 rounded text-sm transition-all duration-300"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- All Posts -->
    <section class="py-16 bg-slate-800/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12 text-white">
          {TEXTS_GENERAL.blog.allArticles}
        </h2>

        <div
          id="postsContainer"
          class:list={["grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8", { hidden: totalPosts === 0 }]}
        >
          {
            processedPosts.map((post, index) => (
              <PostCard post={post} index={index} variant="catalog" />
            ))
          }
        </div>

        <!-- No results message -->
        <div id="noResults" role="status" class:list={["text-center py-12", { hidden: totalPosts > 0 }]}>
          <div class="text-slate-400 text-lg mb-4">
            <svg
              class="w-16 h-16 mx-auto mb-4 opacity-50"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47-.881-6.08-2.33"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-300 mb-2">
            {TEXTS_GENERAL.blog.empty.title}
          </h3>
          <p class="text-slate-400">
            {TEXTS_GENERAL.blog.empty.description}
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '@/scripts/blog-search';
</script>
