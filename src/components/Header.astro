---
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import { SITE_DATA } from '@/lib/site.ts';
import { MAIN_NAVIGATION, SITE_PAGES } from '@/lib/navigation.ts';
import { HEADER_RESOURCES } from '@/lib/links.ts';
import SupportMenu from "@/components/SupportMenu.astro";
import BrandLogo from "@/assets/marcvspt.svg";
import AdventSecIcon from "@/assets/adventsec.svg";
import cyberEventsLogoUrl from "@/assets/cyberevents.svg?url&no-inline";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActivePage = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
const navigationLinkClass =
  "rounded-lg border px-3 py-2 text-sm font-medium transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400";
const navigationStateClass = (href: string) =>
  isActivePage(href)
    ? "border-blue-400/30 bg-blue-500/15 text-blue-200"
    : "border-transparent text-slate-200 hover:border-blue-400/20 hover:bg-blue-500/10 hover:text-blue-300";
const resourceLinkClass =
  "inline-flex items-center gap-2 border-cyan-400/20 bg-cyan-500/5 text-cyan-200 hover:border-cyan-400/50 hover:bg-cyan-500/15 hover:text-cyan-100";
---

<header
  class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800 z-50"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="shrink-0">
        <a
          href={SITE_PAGES.Home.href}
          aria-label={SITE_DATA.name}
          class="inline-flex rounded-lg transition-opacity duration-300 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-400"
        >
          <BrandLogo class="h-10 w-auto shrink-0" aria-hidden="true" focusable="false" />
        </a>
      </div>

      <!-- Navigation -->
      <nav class="hidden lg:flex items-center gap-2 whitespace-nowrap">
        {
          MAIN_NAVIGATION.map((page) => {
            return (
              <a
                href={page.href}
                aria-current={pathname === page.href ? "page" : undefined}
                class:list={[navigationLinkClass, navigationStateClass(page.href)]}
              >
                {page.label}
              </a>
            );
          })
        }
        {HEADER_RESOURCES.map((resource) => (
          <a
            href={resource.href}
            class:list={[
              navigationLinkClass,
              resourceLinkClass,
            ]}
            target="_blank"
            rel="noopener noreferrer"
          >
            {resource.id === "adventsec" && (
              <AdventSecIcon class="size-5 shrink-0" aria-hidden="true" focusable="false" />
            )}
            {resource.id === "cyber-events" ? (
              <img
                src={cyberEventsLogoUrl}
                alt={resource.label}
                width="188"
                height="36"
                class="h-6 w-auto shrink-0"
              />
            ) : resource.label}
          </a>
        ))}
        <SupportMenu />
      </nav>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button
          id="mobileMenuButton"
          type="button"
          aria-label={TEXTS_GENERAL.header.menu}
          aria-expanded="false"
          aria-controls="mobileMenu"
          class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="hidden lg:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto pb-4">
      <div class="flex flex-col space-y-2">
        {
          MAIN_NAVIGATION.map((page) => {
            return (
              <a
                href={page.href}
                aria-current={pathname === page.href ? "page" : undefined}
                class:list={[
                  navigationLinkClass,
                  navigationStateClass(page.href),
                  "flex min-h-12 items-center",
                ]}
              >
                {page.label}
              </a>
            );
          })
        }
        {HEADER_RESOURCES.map((resource) => (
          <a
            href={resource.href}
            class:list={[navigationLinkClass, resourceLinkClass, "min-h-12"]}
            target="_blank"
            rel="noopener noreferrer"
          >
            {resource.id === "adventsec" && (
              <AdventSecIcon class="size-5 shrink-0" aria-hidden="true" focusable="false" />
            )}
            {resource.id === "cyber-events" ? (
              <img
                src={cyberEventsLogoUrl}
                alt={resource.label}
                width="188"
                height="36"
                class="h-6 w-auto shrink-0"
              />
            ) : resource.label}
          </a>
        ))}
        <SupportMenu mobile />
      </div>
    </div>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  function initializeMenu() {
    controller?.abort();
    const button =
      document.querySelector<HTMLButtonElement>("#mobileMenuButton");
    const menu = document.querySelector<HTMLElement>("#mobileMenu");
    if (!button || !menu) return;
    controller = new AbortController();
    const { signal } = controller;
    const supportMenus = Array.from(
      document.querySelectorAll<HTMLDetailsElement>("[data-support-menu]"),
    );
    const closeSupportMenus = () => {
      supportMenus.forEach((supportMenu) => (supportMenu.open = false));
    };
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      button.setAttribute("aria-expanded", String(open));
      if (!open) closeSupportMenus();
    };
    setOpen(false);
    supportMenus.forEach((supportMenu) => {
      supportMenu.addEventListener(
        "focusout",
        (event) => {
          // El panel móvil permanece expandido mientras se usa el menú.
          if (menu.contains(supportMenu)) return;
          if (
            !(event.relatedTarget instanceof Node) ||
            !supportMenu.contains(event.relatedTarget)
          )
            supportMenu.open = false;
        },
        { signal },
      );
      supportMenu.addEventListener(
        "click",
        (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            supportMenu.open = false;
            supportMenu.querySelector("summary")?.focus();
          }
        },
        { signal },
      );
    });
    window.matchMedia("(min-width: 64rem)").addEventListener(
      "change",
      () => setOpen(false),
      { signal },
    );
    button.addEventListener(
      "click",
      () => setOpen(button.getAttribute("aria-expanded") !== "true"),
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        supportMenus.forEach((supportMenu) => {
          if (
            !menu.contains(supportMenu) &&
            event.target instanceof Node &&
            !supportMenu.contains(event.target)
          )
            supportMenu.open = false;
        });
        if (
          button.getAttribute("aria-expanded") === "true" &&
          event.target instanceof Node &&
          !button.contains(event.target) &&
          !menu.contains(event.target)
        )
          setOpen(false);
      },
      { signal },
    );
    menu.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;
        const openSupportMenu = supportMenus.find(
          (supportMenu) => supportMenu.open,
        );
        if (openSupportMenu) {
          openSupportMenu.open = false;
          openSupportMenu.querySelector("summary")?.focus();
          return;
        }
        if (button.getAttribute("aria-expanded") === "true") {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
  }
  document.addEventListener("astro:page-load", initializeMenu);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
