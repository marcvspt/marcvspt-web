---
import { SITE_DATA, SITE_PAGES } from "@/scripts/data.js";
---

<header
  class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800 z-50"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="shrink-0">
        <a
          href={SITE_PAGES.Home.url}
          class="text-2xl font-bold bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent hover:from-blue-300 hover:to-blue-500 transition-all duration-300"
        >
          {SITE_DATA.name}
        </a>
      </div>

      <!-- Navigation -->
      <nav class="hidden md:flex space-x-8">
        {
          Object.values(SITE_PAGES).map((page) => {
            return (
              <a
                href={page.url}
                class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
              >
                {page.title}
              </a>
            );
          })
        }
        <a
          href="https://ctai.marcvspt.tech"
          class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
          target="_blank"
          rel="noopener noreferrer"
        >
          CyberThreat AI
        </a>
        <a
          href="https://cemx.marcvspt.tech"
          class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
          target="_blank"
          rel="noopener noreferrer"
        >
          CyberEvents MX
        </a>
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobileMenuButton"
          type="button"
          aria-label="Menú de navegación"
          aria-expanded="false"
          aria-controls="mobileMenu"
          class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-2">
        {
          Object.values(SITE_PAGES).map((page) => {
            return (
              <a
                href={page.url}
                class="text-slate-300 hover:text-blue-400 transition-colors duration-300 py-2"
              >
                {page.title}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  function initializeMenu() {
    controller?.abort();
    const button =
      document.querySelector<HTMLButtonElement>("#mobileMenuButton");
    const menu = document.querySelector<HTMLElement>("#mobileMenu");
    if (!button || !menu) return;
    controller = new AbortController();
    const { signal } = controller;
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      button.setAttribute("aria-expanded", String(open));
    };
    setOpen(false);
    button.addEventListener(
      "click",
      () => setOpen(button.getAttribute("aria-expanded") !== "true"),
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        if (
          event.target instanceof Node &&
          !button.contains(event.target) &&
          !menu.contains(event.target)
        )
          setOpen(false);
      },
      { signal },
    );
    menu.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a"))
          setOpen(false);
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "Escape" &&
          button.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
  }
  document.addEventListener("astro:page-load", initializeMenu);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
