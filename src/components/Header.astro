---
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import { SITE_DATA } from '@/lib/site.ts';
import { MAIN_NAVIGATION, SITE_PAGES } from '@/lib/navigation.ts';
import { HEADER_RESOURCES } from '@/lib/links.ts';
import SupportMenu from "@/components/SupportMenu.astro";
import BrandLogo from "@/assets/marcvspt.svg";
import AdventSecIcon from "@/assets/adventsec.svg";
import cyberEventsLogoUrl from "@/assets/cyberevents.svg?url&no-inline";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActivePage = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
const navigationLinkClass =
  "rounded-lg border px-3 py-2 text-sm font-medium transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400";
const navigationStateClass = (href: string) =>
  isActivePage(href)
    ? "border-blue-400/30 bg-blue-500/15 text-blue-200"
    : "border-transparent text-slate-200 hover:border-blue-400/20 hover:bg-blue-500/10 hover:text-blue-300";
const resourceLinkClass =
  "inline-flex items-center gap-2 border-cyan-400/20 bg-cyan-500/5 text-cyan-200 hover:border-cyan-400/50 hover:bg-cyan-500/15 hover:text-cyan-100";
---

<header
  class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800 z-50"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="shrink-0">
        <a
          href={SITE_PAGES.Home.href}
          aria-label={SITE_DATA.name}
          class="inline-flex rounded-lg transition-opacity duration-300 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-400"
        >
          <BrandLogo class="h-10 w-auto shrink-0" aria-hidden="true" focusable="false" />
        </a>
      </div>

      <!-- Navigation -->
      <nav aria-label={TEXTS_GENERAL.header.menu} class="hidden lg:flex items-center gap-2 whitespace-nowrap">
        {
          MAIN_NAVIGATION.map((page) => {
            return (
              <a
                href={page.href}
                aria-current={pathname === page.href ? "page" : undefined}
                class:list={[navigationLinkClass, navigationStateClass(page.href)]}
              >
                {page.label}
              </a>
            );
          })
        }
        {HEADER_RESOURCES.map((resource) => (
          <a
            href={resource.href}
            class:list={[
              navigationLinkClass,
              resourceLinkClass,
            ]}
            target="_blank"
            rel="noopener noreferrer"
          >
            {resource.id === "adventsec" && (
              <AdventSecIcon class="size-5 shrink-0" aria-hidden="true" focusable="false" />
            )}
            {resource.id === "cyber-events" ? (
              <img
                src={cyberEventsLogoUrl}
                alt={resource.label}
                width="188"
                height="36"
                class="h-6 w-auto shrink-0"
              />
            ) : resource.label}
          </a>
        ))}
        <SupportMenu />
      </nav>

      <!-- Mobile navigation -->
      <details id="mobileMenu" class="lg:hidden">
        <summary
          class="grid size-11 cursor-pointer list-none place-items-center rounded-lg text-slate-300 transition-colors duration-300 hover:text-blue-400 [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">{TEXTS_GENERAL.header.menu}</span>
          <svg
            aria-hidden="true"
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>

        <nav
          aria-label={TEXTS_GENERAL.header.menu}
          class="absolute inset-x-0 top-full max-h-[calc(100dvh_-_4rem_-_1px)] overflow-y-auto border-b border-slate-800 bg-slate-900 px-4 py-4 sm:px-6"
        >
          <div class="mx-auto flex max-w-6xl flex-col gap-2 px-1">
            {MAIN_NAVIGATION.map((page) => (
              <a
                href={page.href}
                aria-current={pathname === page.href ? "page" : undefined}
                class:list={[
                  navigationLinkClass,
                  navigationStateClass(page.href),
                  "flex min-h-12 items-center",
                ]}
              >
                {page.label}
              </a>
            ))}
            {HEADER_RESOURCES.map((resource) => (
              <a
                href={resource.href}
                class:list={[navigationLinkClass, resourceLinkClass, "min-h-12"]}
                target="_blank"
                rel="noopener noreferrer"
              >
                {resource.id === "adventsec" && (
                  <AdventSecIcon class="size-5 shrink-0" aria-hidden="true" focusable="false" />
                )}
                {resource.id === "cyber-events" ? (
                  <img
                    src={cyberEventsLogoUrl}
                    alt={resource.label}
                    width="188"
                    height="36"
                    class="h-6 w-auto shrink-0"
                  />
                ) : resource.label}
              </a>
            ))}
            <SupportMenu mobile />
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  function initializeMenu() {
    controller?.abort();
    const menu = document.querySelector<HTMLDetailsElement>("#mobileMenu");
    const summary = menu?.querySelector<HTMLElement>(":scope > summary");
    if (!menu || !summary) return;
    controller = new AbortController();
    const { signal } = controller;
    const supportMenus = Array.from(
      document.querySelectorAll<HTMLDetailsElement>("[data-support-menu]"),
    );
    const desktopSupport = supportMenus.filter((supportMenu) => !menu.contains(supportMenu));
    const mobileSupport = supportMenus.find((supportMenu) => menu.contains(supportMenu));

    menu.addEventListener("toggle", () => {
      if (!menu.open && mobileSupport) mobileSupport.open = false;
    }, { signal });
    menu.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    }, { signal });
    desktopSupport.forEach((supportMenu) => {
      supportMenu.addEventListener(
        "focusout",
        (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !supportMenu.contains(event.relatedTarget)
          )
            supportMenu.open = false;
        },
        { signal },
      );
      supportMenu.addEventListener(
        "click",
        (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            supportMenu.open = false;
            supportMenu.querySelector("summary")?.focus();
          }
        },
        { signal },
      );
    });
    window.matchMedia("(min-width: 64rem)").addEventListener(
      "change",
      () => {
        menu.open = false;
        supportMenus.forEach((supportMenu) => (supportMenu.open = false));
      },
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        desktopSupport.forEach((supportMenu) => {
          if (!supportMenu.contains(target)) supportMenu.open = false;
        });
        if (!menu.contains(target)) menu.open = false;
      },
      { signal },
    );
    menu.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          menu.open = false;
          summary.focus();
        }
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;
        const openSupportMenu = supportMenus.find(
          (supportMenu) => supportMenu.open && (!menu.contains(supportMenu) || menu.open),
        );
        if (openSupportMenu) {
          event.preventDefault();
          openSupportMenu.open = false;
          openSupportMenu.querySelector("summary")?.focus();
          return;
        }
        if (menu.open) {
          event.preventDefault();
          menu.open = false;
          summary.focus();
        }
      },
      { signal },
    );
  }
  document.addEventListener("astro:page-load", initializeMenu);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
