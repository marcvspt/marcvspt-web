---
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import { SITE_DATA } from '@/lib/site.ts';
import { MAIN_NAVIGATION, SITE_PAGES } from '@/lib/navigation.ts';
import { HEADER_RESOURCES } from '@/lib/links.ts';
import SupportMenu from "@/components/SupportMenu.astro";
---

<header
  class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800 z-50"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="shrink-0">
        <a
          href={SITE_PAGES.Home.href}
          class="text-2xl font-bold bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent hover:from-blue-300 hover:to-blue-500 transition-all duration-300"
        >
          {SITE_DATA.name}
        </a>
      </div>

      <!-- Navigation -->
      <nav class="hidden lg:flex items-center gap-6">
        {
          MAIN_NAVIGATION.map((page) => {
            return (
              <a
                href={page.href}
                class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
              >
                {page.label}
              </a>
            );
          })
        }
        {HEADER_RESOURCES.map((resource) => (
          <a
            href={resource.href}
            class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
            target="_blank"
            rel="noopener noreferrer"
          >
            {resource.label}
          </a>
        ))}
        <SupportMenu />
      </nav>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button
          id="mobileMenuButton"
          type="button"
          aria-label={TEXTS_GENERAL.header.menu}
          aria-expanded="false"
          aria-controls="mobileMenu"
          class="text-slate-300 hover:text-blue-400 transition-colors duration-300"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="hidden lg:hidden pb-4">
      <div class="flex flex-col space-y-2">
        {
          MAIN_NAVIGATION.map((page) => {
            return (
              <a
                href={page.href}
                class="text-slate-300 hover:text-blue-400 transition-colors duration-300 py-2"
              >
                {page.label}
              </a>
            );
          })
        }
        <SupportMenu mobile />
      </div>
    </div>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  function initializeMenu() {
    controller?.abort();
    const button =
      document.querySelector<HTMLButtonElement>("#mobileMenuButton");
    const menu = document.querySelector<HTMLElement>("#mobileMenu");
    if (!button || !menu) return;
    controller = new AbortController();
    const { signal } = controller;
    const supportMenus = Array.from(
      document.querySelectorAll<HTMLDetailsElement>("[data-support-menu]"),
    );
    const closeSupportMenus = () => {
      supportMenus.forEach((supportMenu) => (supportMenu.open = false));
    };
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      button.setAttribute("aria-expanded", String(open));
      if (!open) closeSupportMenus();
    };
    setOpen(false);
    supportMenus.forEach((supportMenu) => {
      supportMenu.addEventListener(
        "focusout",
        (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !supportMenu.contains(event.relatedTarget)
          )
            supportMenu.open = false;
        },
        { signal },
      );
      supportMenu.addEventListener(
        "click",
        (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            supportMenu.open = false;
            supportMenu.querySelector("summary")?.focus();
          }
        },
        { signal },
      );
    });
    window.matchMedia("(min-width: 64rem)").addEventListener(
      "change",
      () => setOpen(false),
      { signal },
    );
    button.addEventListener(
      "click",
      () => setOpen(button.getAttribute("aria-expanded") !== "true"),
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        supportMenus.forEach((supportMenu) => {
          if (
            event.target instanceof Node &&
            !supportMenu.contains(event.target)
          )
            supportMenu.open = false;
        });
        if (
          button.getAttribute("aria-expanded") === "true" &&
          event.target instanceof Node &&
          !button.contains(event.target) &&
          !menu.contains(event.target)
        )
          setOpen(false);
      },
      { signal },
    );
    menu.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;
        const openSupportMenu = supportMenus.find(
          (supportMenu) => supportMenu.open,
        );
        if (openSupportMenu) {
          openSupportMenu.open = false;
          openSupportMenu.querySelector("summary")?.focus();
          return;
        }
        if (button.getAttribute("aria-expanded") === "true") {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
  }
  document.addEventListener("astro:page-load", initializeMenu);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
