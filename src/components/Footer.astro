---
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import { SITE_DATA } from '@/lib/site.ts';
import { SITE_PAGES, MAIN_NAVIGATION } from '@/lib/navigation.ts';
import { SOCIAL_DATA, EXTERNAL_RESOURCES, LICENSE_LINK } from '@/lib/links.ts';
const currentYear = new Date().getFullYear();

import LinkedInIcon from "@/assets/linkedin.svg";
import GitHubIcon from "@/assets/github.svg";
import HackTheBoxIcon from "@/assets/hackthebox.svg";
import MailIcon from "@/assets/email.svg";
import XIcon from "@/assets/x.svg";
---

<footer class="bg-slate-900 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center md:text-left">
      <!-- Logo y descripción -->
      <div class="md:col-span-2">
        <a
          href={SITE_PAGES.Home.href}
          class="text-2xl font-bold bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
        >
          {SITE_DATA.name}
        </a>
        <p class="mt-4 text-slate-400 max-w-md mx-auto md:mx-0">
          {SITE_DATA.description}
        </p>
        <div class="flex items-center justify-center md:justify-start space-x-4 mt-6">
          {
            SOCIAL_DATA.map((social) => {
              return (
                <a
                  id={`link-${social.id}`}
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-400 hover:text-blue-400 transition-colors duration-300"
                  aria-label={social.label}
                >
                  {social.id === "linkedin" && <LinkedInIcon />}
                  {social.id === "github" && <GitHubIcon />}
                  {social.id === "hackthebox" && <HackTheBoxIcon />}
                  {social.id === "twitter" && <XIcon />}
                  {social.id === "contact" && <MailIcon />}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Enlaces rápidos -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-4">{TEXTS_GENERAL.footer.quickLinks}</h3>
        <ul class="space-y-2">
          {
            MAIN_NAVIGATION.map((page) => {
              return (
                <li>
                  <a
                    href={page.href}
                    class="text-slate-400 hover:text-blue-400 transition-colors duration-300"
                  >
                    {page.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- Recursos útiles -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-4">{TEXTS_GENERAL.footer.resources}</h3>
        <ul class="space-y-2">
          {
            EXTERNAL_RESOURCES.map((resource) => {
              return (
                <li>
                  <a
                    href={resource.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-blue-400 transition-colors duration-300"
                  >
                    {resource.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-12 pt-8 text-center">
      <p class="text-slate-400">
        © {currentYear}. {TEXTS_GENERAL.footer.licenseIntro} <a
          href={LICENSE_LINK.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-secondary/90 transition duration-100 ease-in-out"
          ><strong>{LICENSE_LINK.label}</strong></a
        >.
      </p>
    </div>
  </div>
</footer>
