---
import { TEXTS_GENERAL } from "@/scripts/texts";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPostCards } from "@/scripts/blog";

const allPosts = await getPublishedPostCards();
const posts = allPosts.slice(0, 3);
const featuredPosts = allPosts.filter((post) => post.featured).slice(0, 3);
---

<section id="posts" class="py-20 bg-slate-800/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Artículos Recientes -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        <span
          class="bg-linear-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
        >
          {TEXTS_GENERAL.home.posts.recent}
        </span>
      </h2>
      <p class="text-xl text-slate-400 max-w-2xl mx-auto">
        {TEXTS_GENERAL.home.posts.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {
        posts.map((post, index) => (
          <PostCard post={post} index={index} />
        ))
      }
    </div>

    <!-- Artículos Destacados -->
    {
      featuredPosts.length > 0 && (
        <div>
          <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">
              <span class="bg-linear-to-r from-yellow-400 to-yellow-600 bg-clip-text text-transparent">
                {TEXTS_GENERAL.home.posts.featured}
              </span>
            </h2>
            <p class="text-xl text-slate-400 max-w-2xl mx-auto">
              {TEXTS_GENERAL.home.posts.featuredDescription}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
            {featuredPosts.map((post, index) => (
              <PostCard post={post} index={index} variant="featured" />
            ))}
          </div>
        </div>
      )
    }

    <div class="text-center">
      <a
        href="/blog"
        class="inline-flex items-center px-8 py-3 bg-linear-to-r from-slate-700 to-slate-800 hover:from-slate-600 hover:to-slate-700 text-white font-semibold rounded-lg transition-all duration-300 border border-slate-600 hover:border-blue-500/50"
      >
        {TEXTS_GENERAL.home.posts.viewAll}
        <svg
          class="ml-2 w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
