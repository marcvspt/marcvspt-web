---
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import type { BlogPostCard } from '@/lib/types/blog.ts';
import { formatPostDate, getPostUrl, formatReadTime } from '@/lib/blog/presentation.ts';

interface Props {
  post: BlogPostCard;
  variant?: 'recent' | 'featured' | 'catalog';
}
const { post, variant = 'recent' } = Astro.props;
const highlighted = variant === 'featured';
const catalog = variant === 'catalog';
---

<article
  class:list={[
    'overflow-hidden rounded-xl border border-slate-700 bg-slate-800/80 transition-colors duration-300 group-data-[view=list]/posts:grid group-data-[view=list]/posts:grid-cols-[5rem_minmax(0,1fr)] sm:group-data-[view=list]/posts:grid-cols-[11rem_minmax(0,1fr)]',
    highlighted ? 'hover:border-yellow-500/50 focus-within:border-yellow-500/50' : 'hover:border-blue-500/50 focus-within:border-blue-500/50',
    { 'post-card': catalog },
  ]}
  data-category={catalog ? post.category : undefined}
  data-title={catalog ? post.title : undefined}
  data-description={catalog ? post.description : undefined}
  data-tags={catalog ? post.tags.join(' ') : undefined}
  data-date={catalog ? post.publishedAt.getTime() : undefined}
  data-readtime={catalog ? post.readTimeMinutes : undefined}
>
  <div class="relative overflow-hidden">
    <img
      src={post.thumbnail ?? post.image}
      alt=""
      loading="lazy"
      decoding="async"
      class="h-48 w-full object-cover group-data-[view=list]/posts:absolute group-data-[view=list]/posts:inset-0 group-data-[view=list]/posts:h-full"
    />
  </div>
  <div class="min-w-0 p-6 group-data-[view=list]/posts:p-4">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-slate-300">
      <span class="rounded-full bg-blue-950 px-2.5 py-0.5 font-medium text-blue-200">{post.category}</span>
      {post.featured && (
        <span class="rounded-full bg-yellow-500 px-2.5 py-0.5 font-medium text-yellow-950">{TEXTS_GENERAL.post.featured}</span>
      )}
    </div>
    <h3 class="mb-2 text-xl font-bold text-white group-data-[view=list]/posts:text-lg">
      <a
        href={getPostUrl(post.slug)}
        class:list={['rounded-xs wrap-break-word text-inherit underline decoration-slate-400 underline-offset-4 transition-colors hover:decoration-current focus-visible:decoration-current', highlighted ? 'hover:text-yellow-300 focus-visible:text-yellow-300' : 'hover:text-blue-300 focus-visible:text-blue-300']}
      >
        {post.title}
      </a>
    </h3>
    <div class="mb-3 flex flex-wrap items-center gap-x-2 text-sm text-slate-400">
      <time datetime={post.publishedAt.toISOString()}>{formatPostDate(post.publishedAt)}</time>
      <span aria-hidden="true">•</span><span>{formatReadTime(post.readTimeMinutes)}</span>
    </div>
    <p class="line-clamp-3 text-slate-300 group-data-[view=list]/posts:line-clamp-2">{post.description}</p>
    {catalog && post.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {post.tags.slice(0, 2).map((tag) => <span class="px-2 py-1 bg-slate-700 text-slate-300 text-xs rounded-md">{tag}</span>)}
        {post.tags.length > 2 && <span class="px-2 py-1 bg-slate-600 text-slate-200 text-xs rounded-md">+{post.tags.length - 2}</span>}
      </div>
    )}
  </div>
</article>
