---
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import { SITE_PAGES } from "@/lib/navigation.ts";
---

<section
  class="bg-linear-to-br from-slate-900 via-blue-900 to-slate-900 pb-14 pt-28 sm:pb-20 sm:pt-36"
>
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h1 class="mb-5 text-balance text-4xl font-bold text-white sm:text-5xl md:text-6xl">
      {TEXTS_GENERAL.home.title}
    </h1>

    <p class="mx-auto mb-7 max-w-xl text-pretty text-lg leading-relaxed text-slate-300 md:text-xl">
      {TEXTS_GENERAL.home.description}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="#posts"
        class="inline-flex items-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors duration-300 hover:bg-blue-600"
      >
        {TEXTS_GENERAL.home.explore}
      </a>
      <a
        href={SITE_PAGES.About.href}
        class="inline-flex items-center rounded-lg border border-slate-400 px-6 py-3 font-semibold text-slate-200 transition-colors duration-300 hover:border-blue-300 hover:text-blue-200"
      >
        {SITE_PAGES.About.title}
      </a>
    </div>
  </div>
</section>
